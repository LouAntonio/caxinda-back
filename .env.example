APP_TIMEZONE=Africa/Luanda
PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/caxianda?options=-c%20timezone%3DAfrica%2FLuanda

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=no-reply@caxianda.com

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Regras específicas de rate-limit
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_CHAT_LIMIT=120
THROTTLE_CHAT_TTL_MS=60000
THROTTLE_SUPPORT_LIMIT=30
THROTTLE_SUPPORT_TTL_MS=60000
THROTTLE_PAYMENT_LIMIT=20
THROTTLE_PAYMENT_TTL_MS=60000

# Auth (better-auth) e magic link
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=generate_a_random_secret
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_SESSION_DURATION_MS=604800000
CORS_ORIGINS=http://localhost:5173
FRONT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
AUTH_COOKIE_SAMESITE=lax
USE_SECURE_COOKIES=false
MAGIC_LINK_TTL_MS=900000

# JWT (AuthModule)
JWT_SECRET=generate_a_random_secret
JWT_EXPIRES_IN=7d